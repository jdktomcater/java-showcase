<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="10 seconds">
    <property name="APM_PATTERN" value="[%-5level %d{yyyy-MM-dd HH:mm:ss.SSS} %r [%thread] %c.%M:%L - [%X{tid}] -%msg%n" />
    <!--  skyWalking日志采集  -->
    <appender name="STDOUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>gateway-service.%d{yyyy-MM-dd-HH}.log</fileNamePattern>
            <maxHistory>24</maxHistory>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <Pattern>${APM_PATTERN}</Pattern>
            </layout>
        </encoder>
    </appender>
    <!-- 异步日志 -->
<!--    <appender name="async" class="ch.qos.logback.classic.AsyncAppender">-->
<!--        <discardingThreshold>0</discardingThreshold>-->
<!--        <queueSize>1500</queueSize>-->
<!--        <includeCallerData>true</includeCallerData>-->
<!--        <appender-ref ref="STDOUT" />-->
<!--    </appender>-->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>