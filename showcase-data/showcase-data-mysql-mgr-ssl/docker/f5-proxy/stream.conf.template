upstream mgr_rw {
${RW_SERVERS}
}

upstream mgr_ro {
${RO_SERVERS}
}

server {
    listen ${MGR_RW_LISTEN_PORT};
    proxy_connect_timeout 3s;
    proxy_timeout 1h;
    proxy_pass mgr_rw;
}

server {
    listen ${MGR_RO_LISTEN_PORT};
    proxy_connect_timeout 3s;
    proxy_timeout 1h;
    proxy_pass mgr_ro;
}
