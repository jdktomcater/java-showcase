<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jdktomcat.showcase.data.driver.mapper.DriverBenchmarkMapper">

    <resultMap id="DriverOrderResultMap" type="com.jdktomcat.showcase.data.driver.domain.DriverOrder">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="status" property="status"/>
        <result column="amount" property="amount"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="countAll" resultType="long">
        SELECT COUNT(1)
        FROM t_driver_order
    </select>

    <delete id="deleteAll">
        DELETE FROM t_driver_order
    </delete>

    <insert id="batchInsert">
        INSERT INTO t_driver_order (
            id,
            user_name,
            status,
            amount,
            created_at,
            updated_at
        )
        VALUES
        <foreach collection="items" item="item" separator=",">
            (
                #{item.id},
                #{item.userName},
                #{item.status},
                #{item.amount},
                #{item.createdAt},
                #{item.updatedAt}
            )
        </foreach>
    </insert>

    <select id="selectById" resultMap="DriverOrderResultMap">
        SELECT id, user_name, status, amount, created_at, updated_at
        FROM t_driver_order
        WHERE id = #{id}
    </select>

    <select id="selectByStatus" resultMap="DriverOrderResultMap">
        SELECT id, user_name, status, amount, created_at, updated_at
        FROM t_driver_order
        WHERE status = #{status}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="scanIdsByCreatedAt" resultType="long">
        SELECT id
        FROM t_driver_order
        WHERE created_at BETWEEN #{start} AND #{end}
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <select id="sumAmountByStatus" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0)
        FROM t_driver_order
        WHERE status = #{status}
    </select>
</mapper>
