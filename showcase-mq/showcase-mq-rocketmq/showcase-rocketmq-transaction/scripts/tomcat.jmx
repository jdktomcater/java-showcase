          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="前置参数脚本" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.util.Random;
import java.text.SimpleDateFormat;
import java.util.Date;

Date date = new Date();
SimpleDateFormat simpleDateFormat = new SimpleDateFormat(&quot;yyyyMMddHHmmss&quot;);
chars = &quot;1234567890abcdefghiklmnopqrstuvwxyz&quot;;
int string_length = 4;
moi = &quot;JSTWZYC&quot; + simpleDateFormat.format(date);
for (int i=0; i &lt; string_length; i++) {
  Random random = new Random();
  int randomInt = random.nextInt(chars.length());
  moi += chars.substring(randomInt, randomInt + 1);
}
// 生成商户订单标识
vars.put(&quot;MERCHANT_ORDER_ID&quot;, moi);</stringProp>
          </BeanShellPreProcessor>
