          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import org.apache.commons.codec.digest.DigestUtils;
String merchant_ids=&quot;${merchant_id}&quot;;
String merchant_order_ids=&quot;${merchant_order_id}&quot;;
String typay_order_ids=&quot;${typay_order_id}&quot;;
String keys=&quot;${key}&quot;;

String[] merchantids=merchant_ids.split(&quot;,&quot;);
String[] merchantorder_ids=merchant_order_ids.split(&quot;,&quot;);
String[] typayorder_ids=typay_order_ids.split(&quot;,&quot;);
String[] key=keys.split(&quot;,&quot;);

String signs=&quot;&quot;;
String str=&quot;&quot;;
String depositorder_sign=&quot;&quot;;

//${__MD5(merchant_id=${merchant_id}&amp;merchant_order_id=${merchant_order_id}&amp;pay_paid_amt=${pay_amt}&amp;request_type=3&amp;key=${key},)}
for(int i=0;i&lt;merchantids.length;i++)
{
	if(i==0)
	{
	str=&quot;merchant_id=&quot;+merchantids[i]+&quot;&amp;merchant_order_id=&quot;+merchantorder_ids[i]+&quot;&amp;pay_paid_amt=0.00&amp;request_type=3&amp;key=&quot;+key[i];
	log.info(&quot;加密前str：&quot;+str);
	depositorder_sign=DigestUtils.md5Hex(str);
	log.info(&quot;加密后depositorder_sign：&quot;+depositorder_sign);
	}
	else
	{
	str=&quot;merchant_id=&quot;+merchantids[i]+&quot;&amp;merchant_order_id=&quot;+merchantorder_ids[i]+&quot;&amp;pay_paid_amt=0.00&amp;request_type=3&amp;key=&quot;+key[i];
	log.info(&quot;加密前str：&quot;+str);
	depositorder_sign=depositorder_sign+&quot;,&quot;+DigestUtils.md5Hex(str);
	log.info(&quot;加密后depositorder_sign：&quot;+depositorder_sign);
	}


}
vars.put(&quot;sign&quot;,depositorder_sign);</stringProp>
          </BeanShellPreProcessor>
