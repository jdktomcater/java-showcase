              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="为withdraw_fast_priorityMatchList准备数据">
                <boolProp name="resetInterpreter">true</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">import java.io.*;

int run = Integer.parseInt(&quot;${run}&quot;)+1;
vars.put(&quot;run&quot;,run.toString());
String data=&quot;${typay_order_id}&quot;;
String merchant_ids  =&quot;${merchant_ids}&quot;;
String merchant_order_ids  =&quot;${merchant_order_ids}&quot;;
String typay_order_ids  =&quot;${typay_order_ids}&quot;;
String keys  =&quot;${keys}&quot;;
if(!data.equals(&quot;LLLLLLL&quot;)&amp;&amp;(run==1)){
	merchant_ids=merchant_ids+&quot;${wmerchant_id}&quot;;
	merchant_order_ids=merchant_order_ids+&quot;${merchant_order_id}&quot;;
	typay_order_ids=typay_order_ids+&quot;${typay_order_id}&quot;;
	keys=keys+&quot;${wkey}&quot;;
} else if(!data.equals(&quot;LLLLLLL&quot;)&amp;&amp;(run&gt;1)){
	merchant_ids=merchant_ids+&quot;,${wmerchant_id}&quot;;
	merchant_order_ids=merchant_order_ids+&quot;,${merchant_order_id}&quot;;
	typay_order_ids=typay_order_ids+&quot;,${typay_order_id}&quot;;
	keys=keys+&quot;,${wkey}&quot;;
}
int rerun = Integer.parseInt(&quot;${rerun}&quot;);
if(rerun==run){
	log.info(&quot;=============================&quot;);
	//withdraw_fast_withdrawCancelToAuto准备数据
	String filepath_w=&quot;E:/install/sites/jmeter/plans/data/most_match_20_100.txt&quot;;
	File file_w=new File(filepath_w);
	String data_w = merchant_ids+&quot;;&quot;+keys+&quot;;&quot;+merchant_order_ids+&quot;;&quot;+typay_order_ids+&quot;;&quot;+&quot;0.00\r\n&quot;;
	try {
	  FileOutputStream fos=new FileOutputStream(file_w,true);
	  fos.write(data_w.getBytes());
	  fos.flush();
	  fos.close();
	} catch (IOException e) {
  	  e.printStackTrace();
     }
}
vars.put(&quot;merchant_ids&quot;,merchant_ids);
vars.put(&quot;merchant_order_ids&quot;,merchant_order_ids);
vars.put(&quot;typay_order_ids&quot;,typay_order_ids);
vars.put(&quot;keys&quot;,keys);
log.info(&quot;rerun：${rerun}  run：&quot;+run+&quot;  merchant_ids&quot;+merchant_ids+&quot;   merchant_order_ids:&quot;+merchant_order_ids+&quot;   typay_order_ids:&quot;+typay_order_ids+&quot;   keys:&quot;+keys);


</stringProp>
