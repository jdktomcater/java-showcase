              <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">import org.apache.commons.codec.digest.DigestUtils;
String time =&quot;${__time(YYMMddHHmmss,)}&quot;;
String id = &quot;${__UUID}&quot;.replaceAll(&quot;-&quot;,&quot;&quot;).substring(26);
String merchant_order_id = &quot;TDEST&quot; + time +&quot;${__Random(100000,999999,)}&quot;; 
vars.put(&quot;merchant_order_id&quot;,merchant_order_id);

//vars.put(&quot;merchant_order_id&quot;,&quot;USDTT0320250304183244KPVI&quot;);
vars.put(&quot;user_id&quot;,&quot;${__Random(100000,999999,)}&quot;);
//vars.put(&quot;user_id&quot;,&quot;id&quot;);
vars.put(&quot;member_account&quot;,id+&quot;_mm&quot;);
vars.put(&quot;remark&quot;,time);

//String pay_amt = &quot;400.00&quot;;
