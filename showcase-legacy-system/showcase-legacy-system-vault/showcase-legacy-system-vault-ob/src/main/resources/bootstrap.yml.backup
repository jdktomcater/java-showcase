server:
  port: 8000
spring:
  application:
    name: showcase-vault-simple
  cloud:
    vault:
      enabled: ${VAULT_ENABLED:true}
      fail-fast: true
      authentication: CERT
      uri: https://127.0.0.1:8200
      ssl:
        trust-store: classpath:vault-truststore.jks
        trust-store-password: 123456
        trust-store-type: JKS
        key-store: classpath:client.p12
        key-store-password: 1234
        key-store-type: PKCS12
      database:
        enabled: ${VAULT_DB_ENABLED:true}
        backend: ${VAULT_DB_BACKEND:database}
        role: ${VAULT_DB_ROLE:local_mac_role}
        username-property: spring.datasource.druid.typayv2slave.username
        password-property: spring.datasource.druid.typayv2slave.password
      config:
        lifecycle:
          enabled: true
          min-renewal: 4s
          lease-endpoints: Legacy
logging:
  level:
    org.springframework.cloud.vault: debug
    org.springframework.vault: debug
  config: classpath:logback.xml
  file:
    name: /data/logs/showcase/showcase-vault-simple.log